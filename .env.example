# Copy to .env (gitignored) or set these in your private terminal environment.
# Never commit real keys or paste them into prompts, logs, metadata, or issues.

# Active campaign for commands that do not pass --campaign.
GTA_CAMPAIGN=kreekcraft

# Zernio / Late API credentials.
ZERNIO_API_KEY=

# Zernio account IDs. Only set the ones you actually connected.
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_X_ACCOUNT_ID=

# Optional legacy unattended opt-in. Requires approved clips and authorized sources.
GTA_UNATTENDED_POSTS=

# Optional local override for the official KreekCraft overlay.
KREEKCRAFT_LOGO=
